# MatchGuard runs fully offline by default. Everything below is OPTIONAL.
# Copy to .env and fill in ONE key to enable the LLM tagger / pitch drafter.

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# Force offline mode even if a key is set
# MATCHGUARD_OFFLINE=1
